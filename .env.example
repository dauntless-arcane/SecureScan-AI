# OpenRouter API credentials (backend-only — never baked into any image or exposed to the frontend)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Base URL the browser uses to reach the backend API.
# Baked into the frontend build, so it must be a URL the browser (not the
# frontend container) can reach — the backend's published host port.
VITE_API_BASE_URL=http://localhost:4000
